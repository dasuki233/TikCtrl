<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_preview_container"
    android:layout_width="480dp"
    android:layout_height="640dp"
    android:background="@drawable/bg_float_window">

    <androidx.camera.view.PreviewView
        android:id="@+id/float_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baseline_close_24"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_float_button_selector"
            android:layout_marginEnd="8dp"
            android:contentDescription="关闭" />

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baseline_cameraswitch_24"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_float_button_selector"
            android:layout_marginEnd="8dp"
            android:contentDescription="切换相机" />

        <ImageButton
            android:id="@+id/btn_single_hand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baseline_hand_24"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_float_button_selector"
            android:layout_marginEnd="8dp"
            android:contentDescription="单手模式" />

        <ImageButton
            android:id="@+id/btn_minimize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baseline_minimize_24"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_float_button_selector"
            android:contentDescription="最小化" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom">

        <TextView
            android:id="@+id/tv_gesture_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_no_gesture"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#40000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:radius="12dp" />
    </LinearLayout>

</FrameLayout>